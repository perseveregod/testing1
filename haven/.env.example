# Copy to .env.local and fill in what you need. Everything is optional in
# development: with nothing set, Haven runs on a local JSON store, labeled demo
# data and a test checkout.

# --- App ---------------------------------------------------------------------
# Public URL, used for Stripe redirect URLs. Falls back to the request origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required in production: 32+ random characters (openssl rand -hex 32).
SESSION_SECRET=

# --- Database (Supabase) -----------------------------------------------------
# When both URL and service-role key are set, Haven uses Postgres instead of
# the local file store. Run supabase/migrations/*.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Enables email sign-in through Supabase Auth (its built-in sender allows only a
# few emails per hour; the default email carries a sign-in link).
SUPABASE_ANON_KEY=

# --- Sign-in emails (Resend) -------------------------------------------------
# Recommended. With a Resend key (resend.com, free tier), Haven emails 6-digit
# codes itself with no hourly cap. Until you verify a domain in Resend, the
# shared sender below can only email the address on your Resend account.
RESEND_API_KEY=
EMAIL_FROM="Haven <onboarding@resend.dev>"

# --- Payments (Stripe, one-time) ---------------------------------------------
# Use test keys (sk_test_...) until launch. Without a key, a clearly-labeled
# test checkout is used in development only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Either point at a one-time Stripe Price...
STRIPE_LIFETIME_PRICE_ID=
# ...or set the price here (cents). Changing it needs no code change.
LIFETIME_PRICE_CENTS=1000
LIFETIME_PRICE_CURRENCY=usd

# --- Incident sources --------------------------------------------------------
# Comma list: houston_active, nws_alerts, demo
# houston_active is the City of Houston dispatch page (fire, EMS, police), placed
# with the free US Census geocoder. "demo" seeds fictional incidents for local
# development; never run it next to real feeds in production.
INCIDENT_SOURCES=houston_active,nws_alerts
# State for weather alerts (default TX).
NWS_AREA=TX
# Minutes between automatic refreshes triggered by app traffic.
INGEST_INTERVAL_MIN=3
# Protects /api/cron/ingest (Vercel Cron sends it automatically).
CRON_SECRET=
# Contact email sent in the User-Agent to public APIs (NWS/Nominatim ask for one).
HAVEN_CONTACT_EMAIL=

# --- Map, search, region -----------------------------------------------------
# Where the map opens before location is known (also the demo data center).
NEXT_PUBLIC_DEFAULT_LAT=29.7604
NEXT_PUBLIC_DEFAULT_LNG=-95.3698
# Any MapLibre style URL. Default: OpenFreeMap "dark" (free, no key).
NEXT_PUBLIC_MAP_STYLE_URL=
# Optional: free MapTiler key (cloud.maptiler.com) to turn on the Satellite map style.
NEXT_PUBLIC_MAPTILER_KEY=
# Nominatim-compatible geocoder. Use your own/commercial instance at scale.
GEOCODER_URL=
NEXT_PUBLIC_EMERGENCY_NUMBER=911

# --- Abuse limits ------------------------------------------------------------
REPORTS_PER_HOUR=5
REPORTS_PER_DAY=20
FLAGS_TO_HIDE=3
ENDED_VOTES_TO_RESOLVE=3

# --- Push notifications (Web Push) --------------------------------------------
# Generate once: npx web-push generate-vapid-keys. Without these, alerts stay
# in the in-app inbox only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Map layers ---------------------------------------------------------------
# License plate reader cameras are fetched from OpenStreetMap at build time
# and refreshed every 6 hours (app/layers/alpr-houston). Optional
# comma-separated Overpass mirrors:
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
