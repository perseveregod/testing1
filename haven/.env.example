# Copy to .env.local and fill in what you need. Everything is optional in
# development: with nothing set, Haven runs on a local JSON store, labeled demo
# data and a test checkout.

# --- App ---------------------------------------------------------------------
# Public URL, used for Stripe redirect URLs. Falls back to the request origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required in production: 32+ random characters (openssl rand -hex 32).
SESSION_SECRET=

# --- Database (Supabase) -----------------------------------------------------
# When both URL and service-role key are set, Haven uses Postgres instead of
# the local file store. Run supabase/migrations/*.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Enables email one-time-code sign-in through Supabase Auth.
SUPABASE_ANON_KEY=

# --- Payments (Stripe, one-time) ---------------------------------------------
# Use test keys (sk_test_...) until launch. Without a key, a clearly-labeled
# test checkout is used in development only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Either point at a one-time Stripe Price...
STRIPE_LIFETIME_PRICE_ID=
# ...or set the price here (cents). Changing it needs no code change.
LIFETIME_PRICE_CENTS=1000
LIFETIME_PRICE_CURRENCY=usd

# --- Incident sources --------------------------------------------------------
# Comma list: demo, seattle_fire_911, nws_alerts
INCIDENT_SOURCES=demo
# Limit weather alerts to a state/area code (e.g. WA). Empty = nationwide.
NWS_AREA=
# Minutes between automatic refreshes triggered by app traffic.
INGEST_INTERVAL_MIN=5
# Protects /api/cron/ingest (Vercel Cron sends it automatically).
CRON_SECRET=
# Contact email sent in the User-Agent to public APIs (NWS/Nominatim ask for one).
HAVEN_CONTACT_EMAIL=

# --- Map, search, region -----------------------------------------------------
# Where the map opens before location is known (also the demo data center).
NEXT_PUBLIC_DEFAULT_LAT=29.7604
NEXT_PUBLIC_DEFAULT_LNG=-95.3698
# Any MapLibre style URL. Default: OpenFreeMap "dark" (free, no key).
NEXT_PUBLIC_MAP_STYLE_URL=
# Optional: free MapTiler key (cloud.maptiler.com) to turn on the Satellite map style.
NEXT_PUBLIC_MAPTILER_KEY=
# Nominatim-compatible geocoder. Use your own/commercial instance at scale.
GEOCODER_URL=
NEXT_PUBLIC_EMERGENCY_NUMBER=911

# --- Abuse limits ------------------------------------------------------------
REPORTS_PER_HOUR=5
REPORTS_PER_DAY=20
FLAGS_TO_HIDE=3
ENDED_VOTES_TO_RESOLVE=3
